# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# App
NODE_ENV=development
# Set when running behind a trusted reverse proxy so request IPs resolve correctly.
TRUST_PROXY=

# Merchant portal (Next.js) public origin + path prefix so deposit API responses include `payment_url`.
# Example: https://pay.example.com/merchant  → payment_url https://pay.example.com/merchant/pay/{public_token}
MERCHANT_PORTAL_PUBLIC_URL=

# Public deposit checkout link TTL (minutes). After this, GET /public/deposit/:token returns expired=true for open deposits.
PAYMENT_LINK_TTL_MINUTES=30

# DPay (see GoldPay docs)
# DPAY_BASE_URL=https://pay.dpayvn.com              # deposit/payment host used for deposit
# DPAY_PAYOUT_BASE_URL=https://payment.dpayvn.com    # payout/payment host used for withdrawal bank payout
# DPAY_LOOK_BASE_URL=https://payment.dpayvn.com              # Look APIs host used for balance inquiry (Look/get_coin)
# DPAY_PAYOUT_INQUIRY_LOOK_BASE_URL=https://pay.dpayvn.com     # Look host used for payout inquiry (Look/pay_order)
